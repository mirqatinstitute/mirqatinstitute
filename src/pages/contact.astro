---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Enrol from '../components/Enrol.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { SITE } from '../data/site';
import { WA, waLink } from '../data/whatsapp';

const CARDS = [
  { label: 'WhatsApp', value: SITE.phoneDisplay, href: waLink(WA.general()), note: 'Fastest way to reach us', wa: true },
  { label: 'Call', value: SITE.phoneDisplay, href: `tel:${SITE.phoneE164}`, note: 'Speak to us directly', icon: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z' },
  { label: 'Email', value: SITE.email, href: `mailto:${SITE.email}`, note: 'For detailed questions', icon: 'M3 6h18v12H3zM3 7l9 6 9-6' },
  { label: 'Class timings', value: SITE.timings, note: 'Slots arranged around you', icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2' },
  { label: 'Location', value: SITE.address.display, note: 'Teaching online worldwide', icon: 'M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z' },
  { label: 'Instagram & Facebook', value: '@mirqatinstitue', href: SITE.social.instagram, note: 'Follow our updates', icon: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z' },
];
const jsonLd = [
  {
    '@type': 'ContactPage',
    '@id': `${SITE.url}/contact#page`,
    url: `${SITE.url}/contact`,
    name: 'Contact Mirqat Institute',
    about: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${SITE.url}/contact` },
    ],
  },
];
---
<BaseLayout
  title="Contact Mirqat Institute — WhatsApp, Phone & Email"
  description={`Contact Mirqat Institute on WhatsApp or call ${SITE.phoneDisplay}, or email ${SITE.email}. Online Quran classes from Kollam, Kerala, with flexible IST timings.`}
  jsonLd={jsonLd}
>
  <PageHero crumb="Contact" title="Contact us" lede="Questions about classes, fees or timings? We're happy to help — WhatsApp is the quickest way to reach us." />

  <section class="section section--slim section--tint">
    <div class="container">
      <ul class="contact-cards">
        {CARDS.map((c) => {
          const inner = (
            <>
              <span class:list={['contact-card__icon', { 'contact-card__icon--wa': c.wa }]} aria-hidden="true">
                {c.wa ? <WhatsAppIcon size={24} /> : <svg viewBox="0 0 24 24"><path d={c.icon} /></svg>}
              </span>
              <span class="contact-card__label">{c.label}</span>
              <strong class="contact-card__value">{c.value}</strong>
              <span class="contact-card__note">{c.note}</span>
            </>
          );
          return (
            <li class="reveal">
              {c.href
                ? <a class="contact-card" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined}>{inner}</a>
                : <div class="contact-card">{inner}</div>}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <Enrol edge="tint" heading="Send us a quick enquiry." />
</BaseLayout>
