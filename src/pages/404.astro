---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Mirqat Institute" description="The page you were looking for could not be found." noindex>
  <section class="page-hero page-hero--center page-hero--tall">
    <div class="container">
      <p class="kicker">404</p>
      <h1 class="page-hero__title">This step doesn't exist.</h1>
      <p class="page-hero__lede">The page you were looking for has moved or never existed. Let's get you back on the path.</p>
      <div class="hero__actions hero__actions--center">
        <a href="/" class="btn btn--primary btn--lg">Go to the homepage</a>
        <a href="/courses" class="btn btn--ghost btn--lg">Browse courses</a>
      </div>
    </div>
  </section>
</BaseLayout>
