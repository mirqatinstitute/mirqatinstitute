---
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';
import { WA, waLink } from '../data/whatsapp';
const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
---
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="logo logo--light" aria-label="Mirqat Institute — back to top">
        <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="7" fill="#FEF1BC"/>
          <rect x="5" y="21" width="22" height="6" rx="1.5" fill="#436E5B"/>
          <rect x="11" y="14" width="16" height="6" rx="1.5" fill="#6A9C77"/>
          <rect x="17" y="7" width="10" height="6" rx="1.5" fill="#7DC384"/>
        </svg>
        <span class="logo__text">
          <span class="logo__en">Mirqat Institute</span>
          <span class="logo__ar" lang="ar" dir="rtl">مِرْقاة</span>
        </span>
      </a>
      <p>Making authentic Qur'anic education accessible, engaging and effective for learners of all ages.</p>
      <div class="social" aria-label="Mirqat Institute on social media">
        <a href="https://www.instagram.com/mirqatinstitue/" aria-label="Instagram" target="_blank" rel="noopener me"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".9" fill="currentColor" stroke="none"/></svg></a>
        <a href="https://www.facebook.com/mirqatinstitue" aria-label="Facebook" target="_blank" rel="noopener me"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v6h4v-6h3l1-4h-4V8z"/></svg></a>
        <a href={waLink(WA.general())} aria-label="WhatsApp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8c-1-.4-2.4-1.8-2.8-2.8l.8-1-1-2z" fill="currentColor" stroke="none"/></svg></a>
      </div>
    </div>

    <div class="footer__col">
      <h4>Courses</h4>
      <a href="/courses">All courses</a>
      {courses.map((c) => <a href={`/courses/${c.id}`}>{c.data.title}</a>)}
    </div>

    <div class="footer__col">
      <h4>Institute</h4>
      <a href="/#about">About</a>
      <a href="/#teachers">Teachers</a>
      <a href="/#pricing">Pricing</a>
      <a href="/#how">How to enrol</a>
      <a href="/#faq">FAQ</a>
    </div>

    <div class="footer__col">
      <h4>Contact</h4>
      <a href={waLink(WA.general())} target="_blank" rel="noopener">WhatsApp: {SITE.phoneDisplay}</a>
      <a href="tel:+919400738280">Call: +91 94007 38280</a>
      <a href="mailto:mirqatinstitute313@gmail.com">mirqatinstitute313@gmail.com</a>
      <span>Kollam, Kerala, India</span>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>© {new Date().getFullYear()} Mirqat Institute. All rights reserved.</span>
    <span class="footer__tag">Step by step, toward the Qur'an</span>
  </div>
</footer>
