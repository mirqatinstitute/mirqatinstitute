<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">
        <span lang="ar" dir="rtl" class="eyebrow__ar">مِرْقاة</span>
        <span>the ascending stairway</span>
      </p>
      <h1 class="hero__title">
        Climb closer to the Qur'an, <em>one step at a time.</em>
      </h1>
      <p class="hero__lede">
        One-to-one <strong>online Quran classes</strong> in Noorani Qaida, Tajweed, Qur'an reading, Hifz and revision —
        for children, youth and adults, at a time that suits you.
      </p>
      <div class="hero__actions">
        <a href="#enrol" class="btn btn--primary btn--lg">Join a Qur'an class</a>
        <a href="#courses" class="btn btn--ghost btn--lg">Explore courses</a>
      </div>
      <ul class="hero__trust" aria-label="Highlights">
        <li><svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10.5l4 4 8-9"/></svg>1-on-1 online classes</li>
        <li><svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10.5l4 4 8-9"/></svg>Hafs &amp; Shu'bah certified</li>
        <li><svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10.5l4 4 8-9"/></svg>Flexible timings</li>
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <svg viewBox="0 0 440 440" class="stairs">
        <defs>
          <pattern id="geo" width="44" height="44" patternUnits="userSpaceOnUse">
            <path d="M22 4 L27 17 L40 22 L27 27 L22 40 L17 27 L4 22 L17 17 Z" fill="none" stroke="#FEF1BC" stroke-opacity=".08" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="440" height="440" rx="36" fill="#436E5B"/>
        <rect width="440" height="440" rx="36" fill="url(#geo)"/>

        <g class="stairs__star">
          <g transform="translate(345 92)">
            <g class="stairs__spin">
              <polygon points="0,-46 11,-11 46,0 11,11 0,46 -11,11 -46,0 -11,-11" fill="none" stroke="#FEF1BC" stroke-width="1.6"/>
              <polygon points="0,-46 11,-11 46,0 11,11 0,46 -11,11 -46,0 -11,-11" transform="rotate(45)" fill="none" stroke="#FEF1BC" stroke-opacity=".55" stroke-width="1.6"/>
            </g>
            <circle r="9" fill="#FEF1BC"/>
          </g>
        </g>

        <rect class="step step--1" x="36"  y="336" width="368" height="68" rx="12" fill="#2F5444"/>
        <rect class="step step--2" x="112" y="262" width="292" height="66" rx="12" fill="#6A9C77"/>
        <rect class="step step--3" x="188" y="188" width="216" height="66" rx="12" fill="#7DC384"/>
        <rect class="step step--4" x="264" y="150" width="140" height="30" rx="10" fill="#FEF1BC"/>

        <text x="60"  y="378" class="step__label">Qaida</text>
        <text x="136" y="302" class="step__label">Tajweed</text>
        <text x="212" y="228" class="step__label step__label--dark">Hifz</text>
        <text x="282" y="171" class="step__label step__label--dark step__label--sm">Revision</text>
      </svg>

      <div class="hero__badge">
        <span class="hero__badge-num" data-count="800" data-suffix="+">800+</span>
        <span class="hero__badge-txt">students<br>taught so far</span>
      </div>
    </div>
  </div>
</section>
