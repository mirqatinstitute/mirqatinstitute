---
import { getCollection } from 'astro:content';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { WA, waLink } from '../data/whatsapp';

// ---- The Mirqat stairway: one step per course, ascending to the Qur'an ----
const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
const SHORT: Record<string, string> = {
  'noorani-qaida': 'Qaida', tajweed: 'Tajweed', 'quran-reading': 'Reading', hifz: 'Hifz', 'quran-revision': 'Revision',
};
const FRONT = ['#2f5444', '#436e5b', '#5b8c6b', '#7dc384', '#b6dfb4'];
const TOP = ['#5f8a73', '#6f9a80', '#8dbb93', '#a9dbac', '#d8efce'];
const INK = ['#fef1bc', '#fef1bc', '#fef1bc', '#1e3329', '#1e3329'];

const X0 = 40, W = 96, H = 62, GROUND = 470, DX = 40, DY = -26;
const steps = courses.map((c, i) => {
  const left = X0 + i * W, right = left + W, top = GROUND - (i + 1) * H;
  return {
    id: c.id,
    num: String(i + 1).padStart(2, '0'),
    label: SHORT[c.id] ?? c.data.title,
    title: c.data.title,
    summary: c.data.summary,
    left, right, top,
    front: FRONT[i], topFill: TOP[i], ink: INK[i],
    // where the light rests on this step
    orbX: left + W / 2 + DX / 2,
    orbY: top + DY / 2 - 14,
  };
});
const last = steps[steps.length - 1];
const summit = { x: last.orbX, y: last.top + DY / 2 };
const summitOrb = { x: summit.x, y: summit.y - 104 };
---
<section class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">
        <span lang="ar" dir="rtl" class="eyebrow__ar">مِرْقاة</span>
        <span>the ascending stairway</span>
      </p>
      <h1 class="hero__title">
        Climb closer to the Qur'an, <em>one step at a time.</em>
      </h1>
      <p class="hero__lede">
        One-to-one <strong>online Quran classes</strong> for children and adults, at a time that suits you.
      </p>
      <div class="hero__actions">
        <a href="#enrol" class="btn btn--primary btn--lg">Join a Qur'an class</a>
        <a href={waLink(WA.general())} class="btn btn--wa-ghost btn--lg" target="_blank" rel="noopener">
          <WhatsAppIcon size={20} /> Chat on WhatsApp
        </a>
      </div>

    </div>

    <!-- The Mirqat stairway: each step is a course, ascending to the Qur'an -->
    <div class="hero__visual stairway" id="stairway">
      <div class="stair-card" id="stairCard" aria-live="polite">
        <span class="stair-card__step" id="stairCardStep">The summit</span>
        <strong class="stair-card__title" id="stairCardTitle">Learn Qur'an. Live Qur'an. Inspire others.</strong>
        <span class="stair-card__text" id="stairCardText">Every step brings you closer to the Book of Allah. Tap a step to explore it.</span>
        <a class="stair-card__link" id="stairCardLink" href="/courses">See all courses →</a>
      </div>

      <div class="stairway__art">
      <svg class="stairway__svg" viewBox="0 0 600 520" data-summit-x={summitOrb.x} data-summit-y={summitOrb.y} role="group" aria-label="The Mirqat stairway: five course steps leading to the Qur'an">
        <defs>
          <radialGradient id="summitGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#fef1bc" stop-opacity="0.95" />
            <stop offset="45%" stop-color="#fef1bc" stop-opacity="0.45" />
            <stop offset="100%" stop-color="#fef1bc" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="orbGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#fffbe6" stop-opacity="1" />
            <stop offset="40%" stop-color="#fef1bc" stop-opacity="0.75" />
            <stop offset="100%" stop-color="#fef1bc" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="wood" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0%" stop-color="#a87a4f" />
            <stop offset="100%" stop-color="#7a5434" />
          </linearGradient>
          <filter id="soft" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="8" />
          </filter>
        </defs>

        <!-- ground shadow -->
        <ellipse cx="300" cy={GROUND + 18} rx="270" ry="22" fill="#1e3329" opacity="0.12" filter="url(#soft)" />

        <!-- light from the summit -->
        <circle class="stairway__glow" cx={summit.x} cy={summit.y - 70} r="120" fill="url(#summitGlow)" />
        <g class="stairway__rays" stroke="#fef1bc" stroke-width="3" stroke-linecap="round" opacity="0.8">
          {[-70, -40, -12, 16, 46, 76].map((deg) => (
            <line x1={summit.x} y1={summit.y - 70} x2={summit.x + Math.sin((deg * Math.PI) / 180) * 150} y2={summit.y - 70 - Math.cos((deg * Math.PI) / 180) * 150} stroke-opacity="0.35" />
          ))}
        </g>

        <!-- the steps -->
        {steps.map((st, i) => (
          <a class="stair" href={`/courses/${st.id}`} data-i={i} data-num={st.num} data-title={st.title}
             data-summary={st.summary} data-x={st.orbX} data-y={st.orbY} aria-label={`Step ${st.num}: ${st.title}`}>
            <path class="stair__top" d={`M${st.left},${st.top} L${st.right},${st.top} L${st.right + DX},${st.top + DY} L${st.left + DX},${st.top + DY} Z`} fill={st.topFill} />
            <path class="stair__front" d={`M${st.left},${st.top} L${st.right},${st.top} L${st.right},${GROUND} L${st.left},${GROUND} Z`} fill={st.front} />
            {i === steps.length - 1 && (
              <path d={`M${st.right},${st.top} L${st.right + DX},${st.top + DY} L${st.right + DX},${GROUND + DY} L${st.right},${GROUND} Z`} fill="#94c79a" />
            )}
            <text x={st.left + 12} y={st.top + 27} class="stair__num" fill={st.ink}>{st.num}</text>
            <text x={st.left + 12} y={st.top + 46} class="stair__label" fill={st.ink}>{st.label}</text>
          </a>
        ))}

        <!-- summit: an open Qur'an on a rehal (wooden stand) -->
        <g class="stairway__quran" aria-hidden="true" transform={`translate(${summit.x} ${summit.y})`}>
          <path d="M-30,0 L22,-52 M30,0 L-22,-52" stroke="url(#wood)" stroke-width="9" stroke-linecap="round" />
          <path d="M-52,-58 Q-26,-70 0,-58 L0,-40 Q-26,-52 -52,-40 Z" fill="#fffdf4" stroke="#2f5444" stroke-width="2.5" stroke-linejoin="round" />
          <path d="M52,-58 Q26,-70 0,-58 L0,-40 Q26,-52 52,-40 Z" fill="#fffdf4" stroke="#2f5444" stroke-width="2.5" stroke-linejoin="round" />
          <path d="M-44,-58 Q-24,-65 -6,-57 M-44,-52 Q-24,-59 -6,-51 M44,-58 Q24,-65 6,-57 M44,-52 Q24,-59 6,-51" stroke="#7dc384" stroke-width="1.6" fill="none" stroke-linecap="round" />
          <path d="M-56,-38 Q-26,-50 0,-38 Q26,-50 56,-38" stroke="#2f5444" stroke-width="5" fill="none" stroke-linecap="round" />
        </g>

        <!-- the climbing light (starts at the summit when animations are off) -->
        <g class="stairway__orb" id="stairOrb" style={`transform: translate(${summitOrb.x}px, ${summitOrb.y}px)`} aria-hidden="true">
          <circle r="26" fill="url(#orbGlow)" />
          <circle r="9" fill="#fffbe6" stroke="#7dc384" stroke-width="3" />
        </g>
      </svg>

      <!-- sits in the empty space above the lower steps; never blocks taps on them -->
      <div class="stair-stat">
        <span class="stair-stat__num" data-count="800" data-suffix="+">800+</span>
        <span>students taught so far</span>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/stairway';
</script>
