---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { WA, waLink } from '../data/whatsapp';

interface Props { message?: string }
const { message = WA.general() } = Astro.props;
const href = waLink(message);
---
<div class="wa-float">
  <!-- Greeting bubble: appears once per visit after a few seconds; can be dismissed. -->
  <div class="wa-float__bubble" id="waGreeting" hidden>
    <button type="button" class="wa-float__close" id="waGreetingClose" aria-label="Dismiss message">×</button>
    <a href={href} target="_blank" rel="noopener">
      <strong>Assalamu alaikum 👋</strong>
      <span>Questions about classes? Chat with us on WhatsApp.</span>
    </a>
  </div>
  <a class="wa-float__btn" href={href} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    <WhatsAppIcon size={28} />
    <span class="wa-float__label" aria-hidden="true">Chat with us</span>
  </a>
</div>
