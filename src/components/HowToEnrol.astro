<section class="section section--tint" id="how">
  <div class="container">
    <header class="section-head">
      <p class="kicker">How to enrol</p>
      <h2>Five steps to your first class.</h2>
    </header>

    <ol class="how">
      <li class="how__step reveal">
        <span class="how__num">1</span>
        <h3>Contact us</h3>
        <p>Message us on WhatsApp or send the enrolment form.</p>
      </li>
      <li class="how__step reveal">
        <span class="how__num">2</span>
        <h3>Choose a course</h3>
        <p>We'll help you pick the right course for the student's level.</p>
      </li>
      <li class="how__step reveal">
        <span class="how__num">3</span>
        <h3>Select a timing</h3>
        <p>Pick a class slot that fits your schedule (IST).</p>
      </li>
      <li class="how__step reveal">
        <span class="how__num">4</span>
        <h3>Register</h3>
        <p>Complete your registration and choose your plan.</p>
      </li>
      <li class="how__step reveal">
        <span class="how__num">5</span>
        <h3>Begin classes</h3>
        <p>Start your journey with the Qur'an, one step at a time.</p>
      </li>
    </ol>
  </div>
</section>
