---
interface Props {
  /** Pages without the enquiry form send "Enrol now" to the Contact page's form. */
  hasEnrol?: boolean;
}
const { hasEnrol = true } = Astro.props;
const enrolHref = hasEnrol ? '#enrol' : '/contact#enrol';
---
<header class="site-header" id="top">
  <div class="container site-header__inner">
    <a href="/" class="logo" aria-label="Mirqat Institute — home">
      <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="#436E5B"/>
        <rect x="5" y="21" width="22" height="6" rx="1.5" fill="#6A9C77"/>
        <rect x="11" y="14" width="16" height="6" rx="1.5" fill="#7DC384"/>
        <rect x="17" y="7" width="10" height="6" rx="1.5" fill="#FEF1BC"/>
      </svg>
      <span class="logo__text">
        <span class="logo__en">Mirqat Institute</span>
        <span class="logo__ar" lang="ar" dir="rtl">مِرْقاة</span>
      </span>
    </a>

    <nav class="nav" id="nav" aria-label="Main">
      <a href="/about">About</a>
      <a href="/courses">Courses</a>
      <a href="/faculties">Faculties</a>
      <a href="/pricing">Pricing</a>
      <a href="/contact">Contact</a>
      <a href={enrolHref} class="btn btn--primary btn--sm nav__cta">Enrol now</a>
    </nav>

    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
