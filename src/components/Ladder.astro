---
// "The Mirqat path": a journey map of the five courses on a rising, stepped route.
import { getCollection } from 'astro:content';
import { WA, waLink } from '../data/whatsapp';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  /** Background of the sections above/below, so the stepped edges blend in. */
  edgeTop?: 'paper' | 'tint';
  edgeBottom?: 'paper' | 'tint';
}
const { edgeTop = 'paper', edgeBottom = 'paper' } = Astro.props;

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
const GUIDE: Record<string, { start: string; outcome: string }> = {
  'noorani-qaida': { start: "You're new to Arabic letters", outcome: 'Read Arabic letters and words correctly' },
  tajweed: { start: 'You can read Arabic letters', outcome: 'Recite with the rules of Tajweed' },
  'quran-reading': { start: 'You know the rules of Tajweed', outcome: 'Read the Mushaf fluently and accurately' },
  hifz: { start: 'You read the Qur’an with Tajweed', outcome: 'Memorise the Qur’an, in part or in full' },
  'quran-revision': { start: 'You’ve memorised the Qur’an', outcome: 'Keep your Hifz strong for life' },
};
const ROUTE_H = 120;
const steps = courses.map((c, i) => ({
  id: c.id,
  num: String(i + 1).padStart(2, '0'),
  title: c.data.title,
  ...(GUIDE[c.id] ?? { start: c.data.forWhom[0], outcome: c.data.summary }),
  above: i % 2 === 0,
  y: ROUTE_H - 14 - i * 22, // node height on the rising route
}));
const n = steps.length;
// stepped route across the full width (x in 0..1000, y in 0..ROUTE_H)
const route = steps
  .map((s, i) => `${i === 0 ? 'M0' : `V${s.y}`},${i === 0 ? s.y : ''} H${((i + 1) / n) * 1000}`)
  .join(' ')
  .replace(/,\s/g, ' ')
  .replace(/,$/, '');
---
<section class="ladder" id="ladder">
  <div class:list={['stepped-edge', 'stepped-edge--top', { 'stepped-edge--tint': edgeTop === 'tint' }]} aria-hidden="true"></div>
  <div class="container">
    <header class="section-head section-head--light">
      <p class="kicker">The Mirqat path</p>
      <h2>Find your starting step.</h2>
      <p>Five steps, one journey. Start where you are — we'll climb with you from there.</p>
    </header>

    <div class="path-map" style={`--route-h:${ROUTE_H}px`}>
      <svg class="path-map__route" viewBox={`0 0 1000 ${ROUTE_H}`} preserveAspectRatio="none" aria-hidden="true">
        <path d={route} fill="none" stroke="rgba(254,241,188,0.35)" stroke-width="3" stroke-dasharray="2 8" stroke-linecap="round" vector-effect="non-scaling-stroke" />
      </svg>

      {steps.map((s, i) => (
        <>
          <span class="path-node" style={`--col:${i + 1}; --row:${i + 1}; --y:${s.y}px`} data-dir={s.above ? 'up' : 'down'} aria-hidden="true">{s.num}</span>
          <a class:list={['path-stop', 'reveal', s.above ? 'path-stop--above' : 'path-stop--below', { 'path-stop--summit': i === n - 1 }]}
             href={`/courses/${s.id}`} style={`--col:${i + 1}; --row:${i + 1}`}>
            <span class="path-stop__step">Step {s.num}</span>
            <strong class="path-stop__title">{s.title}</strong>
            <span class="path-stop__label">Start here if</span>
            <span class="path-stop__text">{s.start}</span>
            <span class="path-stop__label">You'll be able to</span>
            <span class="path-stop__text">{s.outcome}</span>
            <span class="path-stop__more" aria-hidden="true">View course →</span>
          </a>
        </>
      ))}
    </div>

    <p class="path-map__help">
      Not sure where you fit? <a href={waLink(WA.notSure())} target="_blank" rel="noopener"><WhatsAppIcon size={18} /> Ask us on WhatsApp</a>
    </p>
  </div>
  <div class:list={['stepped-edge', 'stepped-edge--bottom', { 'stepped-edge--tint': edgeBottom === 'tint' }]} aria-hidden="true"></div>
</section>
