---
import { Image } from 'astro:assets';
import saahil from '../assets/teachers/muhammed-saahil.webp';
import male from '../assets/teachers/male-profile.webp';
import female from '../assets/teachers/female-profile.webp';
import abdulMajid from '../assets/teachers/abdul-majid.webp';
import { TEACHERS } from '../data/site';

interface Props { tint?: boolean }
const { tint = true } = Astro.props;
// Real photos are keyed by name; 'male' / 'female' are profile illustrations.
const photos = { male, female, 'abdul-majid': abdulMajid };
const isReal = (key: string) => key !== 'male' && key !== 'female';
---
<section class:list={['section', { 'section--tint': tint }]} id="teachers">
  <div class="container">
    <header class="section-head">
      <p class="kicker">Our teachers</p>
      <h2>Meet your Qur'an tutors.</h2>
      <p>A team of male and female tutors — huffaz, hafilaths and Tajweed specialists — teaching one-to-one.</p>
    </header>

    <article class="tutor tutor--featured reveal">
      <Image class="tutor__photo" src={saahil} widths={[200, 400]} sizes="200px"
             alt="Muhammed Saahil, Qur'an tutor at Mirqat Institute" />
      <div class="tutor__body">
        <h3>Muhammed Saahil</h3>
        <p class="tutor__role">Qur'an Tutor</p>
        <p class="tutor__bio">
          Specialised in Qur'an recitation, Tajweed, memorisation and Islamic studies.
          Experienced in teaching students through both online and offline classes.
        </p>
        <ul class="tutor__creds" aria-label="Qualifications">
          <li>M.A. Arabic</li>
          <li>Hafs &amp; Shu'bah Riwayah certified</li>
          <li>3+ years teaching</li>
        </ul>
      </div>
    </article>

    <ul class="tutor-grid" aria-label="More Mirqat teachers">
      {TEACHERS.map((t) => (
        <li class="tutor-mini reveal" data-placeholder={t.sample ? 'true' : undefined}>
          <Image class="tutor-mini__photo" src={photos[t.photo]} widths={[80, 160]} sizes="80px"
                 alt={isReal(t.photo) ? `${t.name}, Qur'an tutor at Mirqat Institute` : `Profile illustration for ${t.name}`} />
          <h3>{t.name}</h3>
          <p>{t.role}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
