---
import { Image } from 'astro:assets';
import saahil from '../assets/teachers/muhammed-saahil.webp';
import nihala from '../assets/teachers/nihala-jamal.webp';

interface Props { tint?: boolean }
const { tint = true } = Astro.props;
---
<section class:list={['section', { 'section--tint': tint }]} id="teachers">
  <div class="container">
    <header class="section-head">
      <p class="kicker">Our teachers</p>
      <h2>Meet your Qur'an tutors.</h2>
    </header>

    <div class="tutors">
      <article class="tutor reveal">
        <Image class="tutor__photo" src={saahil} widths={[168, 336]} sizes="168px"
               alt="Muhammed Saahil, Qur'an tutor at Mirqat Institute" />
        <h3>Muhammed Saahil</h3>
        <p class="tutor__role">Qur'an Tutor</p>
        <p class="tutor__bio">
          Specialised in Qur'an recitation, Tajweed, memorisation and Islamic studies.
          Experienced in teaching students through both online and offline classes.
        </p>
        <ul class="tutor__creds" aria-label="Qualifications">
          <li>B.A. Arabic</li>
          <li>M.A. Arabic</li>
          <li>Hafs &amp; Shu'bah Riwayah certified</li>
          <li>3+ years teaching</li>
        </ul>
      </article>

      <!-- SAMPLE CONTENT: Nihala Jamal's role, bio and qualifications are placeholders.
           Replace with her real details (and photo, if she wishes) before relying on them. -->
      <article class="tutor reveal" data-placeholder="true">
        <Image class="tutor__photo tutor__photo--icon" src={nihala} widths={[168, 336]} sizes="168px"
               alt="Profile illustration for Nihala Jamal, Qur'an tutor at Mirqat Institute" />
        <h3>Nihala Jamal</h3>
        <p class="tutor__role">Qur'an Tutor · Sisters &amp; Children</p>
        <p class="tutor__bio">
          Teaches Noorani Qaida, Tajweed and Qur'an reading to women and young girls,
          with a patient, encouraging approach that helps beginners grow in confidence.
        </p>
        <ul class="tutor__creds" aria-label="Qualifications">
          <li>B.A. Arabic</li>
          <li>Tajweed certified</li>
          <li>2+ years teaching</li>
        </ul>
      </article>
    </div>
  </div>
</section>
