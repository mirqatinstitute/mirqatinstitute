---
import { COURSE_OPTIONS, SITE } from '../data/site';
import { WA, waLink } from '../data/whatsapp';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  course?: string;
  heading?: string;
  /** Background of the section above, so the stepped edge blends in. */
  edge?: 'paper' | 'tint';
}
const { course, heading = 'Take your first step today.', edge = 'paper' } = Astro.props;

const STUDENTS = [
  { value: 'Child', emoji: '🧒' },
  { value: 'Youth', emoji: '🧑' },
  { value: 'Adult', emoji: '👤' },
];
const TIMES = [
  { value: 'Morning', emoji: '🌅' },
  { value: 'Afternoon', emoji: '☀️' },
  { value: 'Evening', emoji: '🌙' },
  { value: 'Any time', emoji: '🕐' },
];
// Initial preview (before JS fills it in live).
const initialPreview = WA.enrol({ course });
---
<section class="cta" id="enrol">
  <div class:list={['stepped-edge', 'stepped-edge--top', { 'stepped-edge--tint': edge === 'tint' }]} aria-hidden="true"></div>
  <div class="container cta__grid">
    <div class="cta__copy">
      <p class="cta__verse" lang="ar" dir="rtl">وَقُل رَّبِّ زِدْنِي عِلْمًا</p>
      <p class="cta__verse-en">“And say: My Lord, increase me in knowledge.” <span>— Qur'an 20:114</span></p>
      <h2>{heading}</h2>
      <p>Tap a few options and send — your enquiry opens in WhatsApp, ready to go. We'll help you choose the right course and a class time that suits you.</p>

      <ul class="contact-list">
        <li>
          <span class="contact-list__label">WhatsApp &amp; phone</span>
          <a href={waLink(WA.general())} target="_blank" rel="noopener" class="contact-list__wa">
            <WhatsAppIcon size={20} /> {SITE.phoneDisplay}
          </a>
        </li>
        <li>
          <span class="contact-list__label">Email</span>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>
          <span class="contact-list__label">Class timings</span>
          <span>{SITE.timings}</span>
        </li>
        <li>
          <span class="contact-list__label">Location</span>
          <span>{SITE.address.display} · Online worldwide</span>
        </li>
      </ul>
    </div>

    <form class="wa-form" id="enrolForm" novalidate>
      <div class="wa-form__head">
        <span class="wa-form__badge" aria-hidden="true"><WhatsAppIcon size={24} /></span>
        <div>
          <h3>Enquire on WhatsApp</h3>
          <p>Takes about 20 seconds</p>
        </div>
      </div>

      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" type="text" autocomplete="name" placeholder="e.g. Aisha" required />
      </div>

      <div class="field">
        <label for="course">Course</label>
        <select id="course" name="course" required>
          <option value="" selected={!course} disabled>Choose a course</option>
          {COURSE_OPTIONS.map((c) => (
            <option value={c.value} selected={c.value === course}>{c.emoji}  {c.value}</option>
          ))}
        </select>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="student">Who is learning? <span class="opt">(optional)</span></label>
          <select id="student" name="student">
            <option value="">Select</option>
            {STUDENTS.map((o) => <option value={o.value}>{o.emoji}  {o.value}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="time">Preferred time <span class="opt">(IST)</span></label>
          <select id="time" name="time">
            <option value="">Select</option>
            {TIMES.map((o) => <option value={o.value}>{o.emoji}  {o.value}</option>)}
          </select>
        </div>
      </div>

      <input type="hidden" name="timezone" id="timezone" />

      <!-- Live preview of the message that will open in WhatsApp -->
      <div class="wa-preview" aria-label="Message preview">
        <div class="wa-preview__bar">
          <span class="wa-preview__avatar" aria-hidden="true">M</span>
          <span class="wa-preview__who"><strong>Mirqat Institute</strong><span>Message preview</span></span>
        </div>
        <div class="wa-preview__chat">
          <div class="wa-bubble">
            <div class="wa-bubble__text" id="waPreview" set:text={initialPreview}></div>
            <span class="wa-bubble__meta" aria-hidden="true">now
              <svg viewBox="0 0 18 12" width="16" height="11"><path d="M1 6.5l3 3L10.5 2.5M7 9.5l1 1 6.5-8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn--wa btn--block btn--lg">
        <WhatsAppIcon size={22} /> Send on WhatsApp
      </button>
      <p class="trial-form__status" id="formStatus" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  import '../scripts/enrol';
</script>
